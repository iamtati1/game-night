# ---------------------------------------------------------------- required

# Postgres connection string.
# Render: use the database's INTERNAL URL when the web service is in the same
# region -- it stays on the private network and needs no TLS.
DATABASE_URL=postgresql://user@localhost:5432/dbname

# Signs the session cookie. Rotating it logs everyone out.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# ------------------------------------------------------------- production

# Turns on secure cookies and `trust proxy`, and makes this process serve
# client/dist. Leave unset locally. Render: set NODE_ENV=production.
# NODE_ENV=production

# Render sets PORT itself; the server reads it. Do not set it by hand.

# ------------------------------------------- split deployment only (not used)

# The single-service deployment needs NONE of the following. They exist so the
# client can be moved to its own origin later without code changes.

# Origins allowed to send credentialed cross-origin requests, comma-separated,
# no trailing slash. While unset, the CORS middleware is not mounted at all.
# CLIENT_ORIGIN=https://jolt.onrender.com

# SameSite for the session cookie. Default `lax`, which is correct whenever the
# site and the API share an origin -- as they do here. Only a split deployment
# across two *.onrender.com subdomains needs `none`, and that cookie is
# third-party, which Safari blocks by default.
# COOKIE_SAMESITE=none

# Only for a Postgres URL that requires TLS, e.g. Render's EXTERNAL URL. The
# internal URL used in production does not.
# DATABASE_SSL=true

# --------------------------------------------------------------- optional

# Free key from https://quizapi.io -- server-side only, never sent to the client.
# Without it the game runs entirely on questions already in PostgreSQL.
QUIZAPI_KEY=

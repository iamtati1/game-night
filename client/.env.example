# Origin of the Jolt API. No trailing slash.
#
# NOT required for the standard single-service deployment: Express serves this
# client and /api from one origin, so an unset value means requests go to
# relative /api paths, which is correct in both development and production.
#
# In development Vite's dev proxy forwards /api to http://localhost:3000.
#
# Only needed if the client is ever deployed separately from the API (a Render
# Static Site). Vite inlines it at BUILD time, so changing it means rebuilding.
#
# VITE_API_URL=https://jolt-api.onrender.com
